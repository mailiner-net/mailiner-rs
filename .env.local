# Local docker compose (mail + proxy). Compile-time prefill for `dx serve`
# (`option_env!("MAILINER_DEV_*")`). Export into the environment first:
#   set -a && . ./.env.local && set +a && dx serve -p mailiner-app
#
# IMAP/SMTP host is the compose service name `mail` (SAN on the test cert).
# The browser never resolves it — the proxy container does.

MAILINER_DEV_DISPLAY_NAME=Dev
MAILINER_DEV_EMAIL=dev@mailiner.test
MAILINER_DEV_IMAP_HOST=mail
MAILINER_DEV_IMAP_PORT=993
MAILINER_DEV_IMAP_USER=dev@mailiner.test
MAILINER_DEV_IMAP_PASSWORD=dev
MAILINER_DEV_PROXY_URL=ws://localhost:9400/proxy
MAILINER_DEV_PROXY_TOKEN=
